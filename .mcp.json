{
  "mcpServers": {
    "context7": { "command": "npx", "args": ["-y", "@upstash/context7-mcp@4.4.4"] },
    "playwright": { "command": "npx", "args": ["-y", "@playwright/mcp@0.0.83"] },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": { "Authorization": "Bearer ${GITHUB_MCP_TOKEN:-}" }
    },
    "postgres": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-postgres@0.6.2", "${DEV_DATABASE_URL:-postgresql://localhost:5432/dev}"]
    },
    "sentry": { "type": "http", "url": "https://mcp.sentry.dev/mcp" },
    "excalidraw": { "type": "http", "url": "https://mcp.excalidraw.com" }
  }
}
